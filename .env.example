# =============================================================================
# 企业级本体智能体 - 环境变量配置模板
# 复制为 .env 后再填入真实配置。不要把真实密钥、密码或内网地址提交到仓库。
# =============================================================================

# ----- MySQL 关系型数据库配置 -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=it_ops

# ----- Neo4j 图数据库配置 -----
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ----- LLM 统一配置 -----
LLM_PROVIDER=openai
# 自定义 API 端点；留空则使用 provider 默认 OpenAI 兼容端点
LLM_BASE_URL=
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o
# Embedding 可单独配置；留空则回退到 LLM_BASE_URL / LLM_API_KEY
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_DIMENSIONS=1536

# ----- 路径与目录配置 -----
ONTOLOGY_DIR=ontology_workspace
MAPPING_FILE=database_mapping.yaml
USERS_FILE=data/users/users.json

# ----- Kafka 配置 -----
KAFKA_BROKER=localhost:9092
# 可选：让 CDC 增量同步写入指定场景命名空间
CDC_SCENE_ID=

# ----- Langfuse 可观测性配置 -----
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# ----- Docker Compose / Langfuse 自托管示例配置 -----
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
LANGFUSE_POSTGRES_PASSWORD=change_me_postgres_password
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=change_me_clickhouse_password
LANGFUSE_MINIO_ACCESS_KEY=change_me_minio_access_key
LANGFUSE_MINIO_SECRET_KEY=change_me_minio_secret_key
LANGFUSE_NEXTAUTH_SECRET=change_me_nextauth_secret
LANGFUSE_SALT=change_me_langfuse_salt
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_INIT_USER_PASSWORD=change_me_langfuse_admin_password

# ----- Web 平台安全配置 -----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# 生产环境建议改用 ADMIN_PASSWORD_HASH，格式由 ontology_intelligence.security.hash_password() 生成
ADMIN_PASSWORD_HASH=
